# Compose-level variables — read directly by `docker compose` (NOT by
# Laravel/PHP). Must match AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY in
# backend/.env exactly: docker-compose.prod.yml uses these values to set
# MinIO's root credentials, while the minio-init service reads the same
# keys from backend/.env to authenticate against MinIO. If the two values
# differ, minio-init fails silently with an access-denied error.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
