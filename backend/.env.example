# Field Notes Laravel API — copy this file to .env and fill in all values.
# This file is safe to commit. Never commit .env itself.

APP_NAME="Field Notes API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_LOCALE=en
APP_FALLBACK_LOCALE=en

# Frontend origin allowed for CORS and Sanctum cookies
FRONTEND_URL=http://localhost:5173
FRONTEND_URLS=http://localhost:5173,http://localhost:8080

LOG_CHANNEL=stack
LOG_LEVEL=debug
CACHE_STORE=database
QUEUE_CONNECTION=database

# ── Database ──────────────────────────────────────────────────────────────────
# Local dev: DB_HOST=mysql (Docker service name)
# Production: use Aiven MySQL external host/port (TLS is automatic via Aiven)
DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=field_notes
DB_USERNAME=field_notes
DB_PASSWORD=field_notes

# ── Session / Sanctum ─────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false
SESSION_SAME_SITE=lax
# Production: SESSION_SECURE_COOKIE=true, SESSION_SAME_SITE=none, SESSION_DOMAIN=.yourdomain.com
SANCTUM_STATEFUL_DOMAINS=localhost:5173,localhost:8080,127.0.0.1:5173,127.0.0.1:8080
# Production: SANCTUM_STATEFUL_DOMAINS=portfolio.yourdomain.com

# ── MinIO (S3-compatible object storage) ──────────────────────────────────────
FILESYSTEM_DISK=s3
AWS_ACCESS_KEY_ID=fieldnotes
AWS_SECRET_ACCESS_KEY=change-this-minio-password
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=portfolio
# Internal endpoint (used by Laravel/PHP inside Docker network)
AWS_ENDPOINT=http://minio:9000
# Public endpoint (used to generate presigned URLs the browser can reach)
# Local:      http://localhost:9000
# Production: https://storage.yourdomain.com
MINIO_PUBLIC_ENDPOINT=http://localhost:9000
MINIO_PUBLIC_URL=http://localhost:9000/portfolio

# ── Google OAuth (optional) ───────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8080/api/auth/google/callback
# Production: GOOGLE_REDIRECT_URI=https://api.yourdomain.com/api/auth/google/callback

# ── Admin seed account ────────────────────────────────────────────────────────
# Change ADMIN_PASSWORD before production! Use: openssl rand -base64 24 | tr -d '=+/' | cut -c1-20
ADMIN_NAME="Dara Sovann"
ADMIN_EMAIL=portfolio.owner@example.com
ADMIN_PASSWORD=peaceful123
